# development | test | production
AQUA_FEEDS_ENV=development
PORT=3020

# Domínio público do serviço (HTTPS). O DID do serviço vira did:web:<hostname>.
FEEDGEN_HOSTNAME=feeds.aquaapp.systems
# DID da conta que publica o feed (sai do `npm run publish-feed`).
FEEDGEN_PUBLISHER_DID=
FEED_RKEY=em-alta

# Postgres em produção. Vazio = PGlite em PGLITE_DIR (dev).
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Jetstream público da Bluesky (a Aqua usa a rede da Bluesky: bsky.social + api.bsky.app).
# Se a Aqua tiver relay/Jetstream próprio, troque aqui.
JETSTREAM_ENABLED=1
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# Filtros do que entra no feed
FEED_LANGS=pt
# Lista de DIDs da rede Aqua (vírgula). Vazio = qualquer autor no idioma.
FEED_AUTHOR_DIDS=

# Ranking
RETENTION_HOURS=72
MAX_PER_AUTHOR=3
MIN_ENGAGEMENT=1
SNAPSHOT_SIZE=1000
REFRESH_SECONDS=120
SNAPSHOT_TTL_MINUTES=60

# Só para o script publish-feed (não precisa no servidor)
FEEDGEN_HANDLE=
FEEDGEN_APP_PASSWORD=
FEEDGEN_PDS_URL=https://bsky.social
