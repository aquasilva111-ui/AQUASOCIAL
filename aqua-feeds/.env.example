# development | test | production
AQUA_FEEDS_ENV=development
PORT=3020

# Domínio público do serviço (HTTPS). O DID do serviço vira did:web:<hostname>.
FEEDGEN_HOSTNAME=feeds.aquaapp.systems
# DID da conta que publica o feed (sai do `npm run publish-feed`).
FEEDGEN_PUBLISHER_DID=
FEED_RKEY=em-alta

# Postgres em produção. Vazio = PGlite em PGLITE_DIR (dev).
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Jetstream público da Bluesky (a Aqua usa a rede da Bluesky: bsky.social + api.bsky.app).
# Se a Aqua tiver relay/Jetstream próprio, troque aqui.
JETSTREAM_ENABLED=1
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# Filtros do que entra no feed
FEED_LANGS=pt
# Lista de DIDs da rede Aqua (vírgula). Vazio = qualquer autor no idioma.
FEED_AUTHOR_DIDS=

# Ranking
RETENTION_HOURS=72
MAX_PER_AUTHOR=3
MIN_ENGAGEMENT=1
SNAPSHOT_SIZE=1000
REFRESH_SECONDS=120
SNAPSHOT_TTL_MINUTES=60

# "Pra você" (Convenções de Realidade, explicável). 0 desliga.
FOR_YOU_ENABLED=1
FOR_YOU_RKEY=pra-voce
# Dias de sinais por usuário (curtir, salvar, seguir…). A gravidade cai pela metade a cada 14 dias.
SIGNAL_RETENTION_DAYS=180
# De quanto em quanto tempo o que a Aqua inferiu vira um commit "hipótese" no Git pessoal
DIGEST_HOURS=6
# Categorias sensíveis (saúde, política, religião, sexualidade, +18, etnia/raça, sindicato,
# finanças pessoais) NÃO são inferidas, salvo opt-in do usuário. Vazio = lista padrão
# (src/conventions/sensitive.ts); ou um JSON no mesmo formato para trocar a lista.
SENSITIVE_CATEGORIES_FILE=
# Só dev: aceita "X-Aqua-Viewer: did:..." no lugar do JWT (ignorado em produção)
AUTH_DEV_VIEWER_HEADER=0

# Só para o script publish-feed (não precisa no servidor)
FEEDGEN_HANDLE=
FEEDGEN_APP_PASSWORD=
FEEDGEN_PDS_URL=https://bsky.social
# em-alta | pra-voce | todos
FEED=em-alta
