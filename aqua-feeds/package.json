    "@hono/node-server": "^1.13.7",
    "aqua-personal-git": "file:../aqua-personal-git",
    "hono": "^4.6.14",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@atproto/crypto": "^0.5.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
