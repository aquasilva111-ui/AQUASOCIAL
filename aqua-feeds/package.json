{
  "name": "aqua-feeds",
  "version": "0.1.0",
  "private": true,
  "description": "Feed generators da AQUA (AT Protocol): 'Em alta na Aqua'",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
