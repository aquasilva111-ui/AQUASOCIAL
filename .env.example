# The env the app is running in e.g. development, testflight, production
EXPO_PUBLIC_ENV=development

# This is the semver release version of the app, pulled from package.json
EXPO_PUBLIC_RELEASE_VERSION=

# This is the commit hash that the current bundle was made from.
EXPO_PUBLIC_BUNDLE_IDENTIFIER=

# Should be formatted YYMMDDHH so that it increases for each build.
EXPO_PUBLIC_BUNDLE_DATE=0

# The log level for the app's logger transports
EXPO_PUBLIC_LOG_LEVEL=debug

# Enable debug logs for specific logger instances
EXPO_PUBLIC_LOG_DEBUG=session

# Bluesky appview DID
EXPO_PUBLIC_BLUESKY_PROXY_DID=

# Chat service DID
EXPO_PUBLIC_CHAT_PROXY_DID=

#
#
# Bluesky specific values
#
#

# Sentry DSN for telemetry
EXPO_PUBLIC_SENTRY_DSN=

# Bitdrift API key. If undefined, Bitdrift will be disabled.
EXPO_PUBLIC_BITDRIFT_API_KEY=

# bapp-config web worker URL
BAPP_CONFIG_DEV_URL=

# AQUA WIKI: free NASA API key (https://api.nasa.gov). Empty falls back to DEMO_KEY (30 req/hour per IP)
EXPO_PUBLIC_NASA_API_KEY=

# AQUA Identity (AT Protocol). See docs/aqua-identity.md and docs/aqua-pds.md.
# Public origin of this site, no trailing slash. Empty keeps OAuth off except on 127.0.0.1.
EXPO_PUBLIC_AQUA_IDENTITY_ORIGIN=
# Handle suffix for native accounts. Empty until chosen. Not aquaapp.systems.
# Same zone as PDS_SERVICE_HANDLE_DOMAINS, without the leading dot.
EXPO_PUBLIC_AQUA_HANDLE_DOMAIN=
# Own PDS base URL (https://<PDS_HOSTNAME>). Signup stays off until this is set
# AND the flag below is true AND /xrpc/_health returns a version.
EXPO_PUBLIC_AQUA_PDS_URL=
EXPO_PUBLIC_AQUA_PDS_SIGNUP_ENABLED=false
EXPO_PUBLIC_AQUA_IDENTITY_INVITE_REQUIRED=false
EXPO_PUBLIC_AQUA_IDENTITY_CAPTCHA_ENABLED=false
EXPO_PUBLIC_AQUA_IDENTITY_CAPTCHA_SITE_KEY=
# Optional. Defaults leak handle lookups to bsky.social until you run your own resolver.
EXPO_PUBLIC_AQUA_IDENTITY_HANDLE_RESOLVER=
EXPO_PUBLIC_AQUA_IDENTITY_PLC_URL=
EXPO_PUBLIC_AQUA_IDENTITY_DOH_URL=
