# Caddyfile que o installer.sh oficial grava em /pds/caddy/etc/caddy/Caddyfile.
# Troque o e-mail ACME e os hostnames. exemplo.com é placeholder.
# Não é aquaapp.systems.
#
# O instalador só lista PDS_HOSTNAME e *.PDS_HOSTNAME. Se o domínio dos
# handles for outro (PDS_SERVICE_HANDLE_DOMAINS=.exemplo.com com
# PDS_HOSTNAME=pds.exemplo.com), inclua os dois nomes no site, senão o
# certificado de alice.exemplo.com não sai e o handle não resolve por HTTPS.

{
	email admin@exemplo.com
	on_demand_tls {
		ask http://localhost:3000/tls-check
	}
}

pds.exemplo.com, *.exemplo.com {
	tls {
		on_demand
	}
	reverse_proxy http://localhost:3000
}
