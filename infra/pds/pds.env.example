# Exemplo do /pds/pds.env. Copie no VPS e preencha lá.
# Este arquivo não tem segredo. Não commite o pds.env real.
#
# Valores públicos do PDS que já está no ar. Não coloque senha de SMTP aqui.
#
# Gere no servidor (o installer.sh oficial faz isso):
#   PDS_JWT_SECRET=$(openssl rand --hex 16)
#   PDS_ADMIN_PASSWORD=$(openssl rand --hex 16)
#   PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=$(openssl ecparam --name secp256k1 --genkey --noout --outform DER | tail --bytes=+8 | head --bytes=32 | xxd --plain --cols 32)
#
# PDS_SERVICE_HANDLE_DOMAINS precisa começar com ponto. Sem a variável,
# o PDS usa ".$PDS_HOSTNAME". O app usa o mesmo nome sem o ponto
# em EXPO_PUBLIC_AQUA_HANDLE_DOMAIN. Veja docs/aqua-pds.md.

# Hostname público do PDS (TLS e https://pds.aquaapp.online/xrpc/_health).
PDS_HOSTNAME=pds.aquaapp.online

# Zona de handle. O ponto na frente é obrigatório. O app usa aquaapp.online sem o ponto.
PDS_SERVICE_HANDLE_DOMAINS=.aquaapp.online

# Segredos: deixe vazio neste exemplo. Gere no servidor.
PDS_JWT_SECRET=
PDS_ADMIN_PASSWORD=
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=

PDS_DATA_DIRECTORY=/pds
PDS_BLOBSTORE_DISK_LOCATION=/pds/blocks
PDS_BLOB_UPLOAD_LIMIT=314572800

PDS_DID_PLC_URL=https://plc.directory
PDS_BSKY_APP_VIEW_URL=https://api.bsky.app
PDS_BSKY_APP_VIEW_DID=did:web:api.bsky.app
PDS_REPORT_SERVICE_URL=https://mod.bsky.app
PDS_REPORT_SERVICE_DID=did:plc:ar7c4by46qjdydhdevvrndac
PDS_CRAWLERS=https://bsky.network

LOG_ENABLED=true
PDS_RATE_LIMITS_ENABLED=true
# O servidor no ar não exige convite (describeServer inviteCodeRequired=false).
PDS_INVITE_REQUIRED=false

# SMTP já configurado no servidor. O remetente público é confirmation@aquaapp.online.
# A URL com senha fica só em /pds/pds.env. Não cole a senha neste repositório.
# PDS_EMAIL_FROM_ADDRESS=confirmation@aquaapp.online
