{
  "name": "aqua-hub",
  "private": true,
  "version": "0.1.0",
  "description": "AQUA Creative Hub (web): editors for every tool, on top of aqua-runtime",
  "type": "module",
  "scripts": {
    "prep": "rm -rf public/reveal && cp -R node_modules/reveal.js/dist public/reveal",
    "dev": "npm run prep && vite",
    "build": "npm run prep && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@fontsource/inter": "^5.0.0",
    "@huggingface/transformers": "^4.3.0",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@univerjs/preset-sheets-core": "*",
    "@univerjs/presets": "*",
    "aqua-design-core": "file:../aqua-design-core",
    "aqua-project": "file:../aqua-project",
    "aqua-runtime": "file:../aqua-runtime",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reveal.js": "^6.0.2",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
