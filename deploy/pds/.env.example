# AQUA PDS — copie para .env e preencha os secrets
# Gere os valores com os comandos do docs/BACKEND-QUICKSTART.md

PDS_HOSTNAME=pds.seudominio.com
PDS_JWT_SECRET=
PDS_ADMIN_PASSWORD=
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=

PDS_DATA_DIRECTORY=/pds
PDS_BLOBSTORE_DISK_LOCATION=/pds/blocks
PDS_BLOB_UPLOAD_LIMIT=314572800

# PLC e rede principal (pode mudar depois para seus próprios)
PDS_DID_PLC_URL=https://plc.directory
PDS_BSKY_APP_VIEW_URL=https://api.bsky.app
PDS_BSKY_APP_VIEW_DID=did:web:api.bsky.app
PDS_REPORT_SERVICE_URL=https://mod.bsky.app
PDS_REPORT_SERVICE_DID=did:plc:ar7c4by46qjdydhdevvrndac
PDS_CRAWLERS=https://bsky.network

LOG_ENABLED=true
PDS_RATE_LIMITS_ENABLED=true
PDS_INVITE_REQUIRED=true

# E-mail (opcional no começo)
# PDS_EMAIL_SMTP_URL=smtp://user:pass@smtp.exemplo.com:587
# PDS_EMAIL_FROM_ADDRESS=noreply@seudominio.com
