RewriteEngine On

# Serve existing static files and directories normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Missing build assets must remain 404s instead of returning HTML.
RewriteRule ^static/ - [L]

# App routes, including profiles with dots in their handles, use the SPA.
RewriteRule ^ index.html [L]
