RewriteEngine On

ErrorDocument 404 /404.html

AddType text/markdown .md
AddCharset UTF-8 .md .txt
AddType application/xml .xml

<IfModule mod_headers.c>
  Header always merge Vary "Accept" "expr=%{THE_REQUEST} =~ m#^[A-Z]+ /(?:[?][^ ]*)? HTTP/#"
  Header always set Link '</llms.txt>; rel=describedby; type="text/plain", </index.md>; rel=alternate; type="text/markdown"' "expr=%{THE_REQUEST} =~ m#^[A-Z]+ /(?:[?][^ ]*)? HTTP/#"
  # aquaapp.systems and www stay indexable. Every other host (teste.,
  # a Hostinger preview hostname, anything that is not the public site)
  # gets noindex even when this build was made without AQUA_DEPLOY_ENV.
  Header always set X-Robots-Tag "noindex, nofollow" "expr=%{HTTP_HOST} !~ m#^(www\.)?aquaapp\.systems\.?(:[0-9]+)?$#i"
</IfModule>

# Keep generated templates and their routing manifest out of the public URL space.
RewriteCond %{THE_REQUEST} "[[:space:]]/+(_aqua-pages[/[:space:]?]|site-routes[.]json[[:space:]?])" [NC]
RewriteRule ^(?:_aqua-pages(?:/|$)|site-routes[.]json$) - [R=404,L,NC]

# An explicit Markdown request gets the compact overview.
RewriteCond %{HTTP:Accept} "(^|,)[[:space:]]*text/markdown(?=[[:space:];,]|$)(?![^,]*;[[:space:]]*q=0(?:[.]0{0,3})?[[:space:]]*(?:,|$))" [NC]
RewriteRule ^$ index.md [L]

# AQUA_PAGE_RULES

# Old Aqua Views URLs (/videos/...) now live under /views/.
RewriteRule ^videos(/.*)?$ /views$1 [R=301,L]

# Non-production hosts never serve the indexable robots.txt. The disallow
# file lives under _aqua-pages, which is not a public URL (THE_REQUEST above).
# Production hosts fall through and serve the real robots.txt file unchanged.
RewriteCond %{HTTP_HOST} !^(www\.)?aquaapp\.systems\.?(:[0-9]+)?$ [NC]
RewriteRule ^robots\.txt$ /_aqua-pages/robots.disallow.txt [L]

# Serve existing static files and directories normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# A relative static/ URL resolved under a deep route
# (/views/watch/.../static/js/...) is the same hashed file as /static/….
# Serve that file. If it is missing, the next rule 404s instead of the SPA.
RewriteRule ^.+/(static/.+)$ /$1 [L]

# Missing build assets must remain 404s instead of returning HTML.
RewriteCond %{REQUEST_URI} /static/ [NC]
RewriteRule ^ - [L]

# Generated allowlist, including profiles with dots in their handles.
# AQUA_APP_RULES

RewriteRule ^ - [R=404,L]
