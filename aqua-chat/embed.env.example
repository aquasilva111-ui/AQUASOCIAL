# Política de embed do IU Chat dentro do Aqua.
# Copie estas variáveis para o ambiente do serviço que escuta em :3080
# (o compose desta pasta). Não commite o .env real.
#
# O Aqua embute o chat num iframe no mesmo site (localhost com localhost,
# ou um subdomínio do host do Aqua). Testado no Chrome 154:
# - X-Frame-Options: SAMEORIGIN bloqueia o iframe entre portas diferentes.
# - Com frame-ancestors apontando para o Aqua, o iframe abre.
# - Cookie SameSite=Strict continua sendo enviado quando os dois são o mesmo
#   site (portas diferentes não importam). Não use SameSite=None no http
#   local: o navegador descarta o cookie sem Secure, e no Chrome um site
#   diferente (localhost x 127.0.0.1, ou outro domínio) não leva o cookie
#   mesmo com Lax.
# - CROSS_ORIGIN_RESOURCE_POLICY fica no padrão (same-origin). Ele não
#   impediu o documento de aparecer; não afrouxar.

SECURITY_HEADERS=true

# CSP obrigatório antes de desligar o X-Frame-Options. A lista substitui
# 'self'. Inclua a origem exata em que o Aqua abre (esquema, host e porta).
CSP_ENABLED=true
CSP_REPORT_ONLY=false
X_FRAME_OPTIONS=off
CSP_FRAME_ANCESTORS='self' http://localhost:19006 http://localhost:8081 http://localhost:3000 http://localhost:19000 http://127.0.0.1:19006 http://127.0.0.1:8081 http://127.0.0.1:3000 http://127.0.0.1:19000 https://aquaapp.systems https://www.aquaapp.systems

# Manter strict. O login no iframe funciona no mesmo site. None só serviria
# para outro site, exige HTTPS e o Chrome pode bloquear mesmo assim.
COOKIE_SAMESITE=strict
